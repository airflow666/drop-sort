{
  // Скрипты подготовки медиаматериалов. Требуют playwright-core, который
  // ставится временно (`npm i -D playwright-core --no-save`) и намеренно не
  // входит в зависимости: он нужен только для генерации иконки, обложки и
  // скриншотов, а тянуть браузер в зависимости игры не за чем.
  //
  // Поэтому эта конфигурация НЕ входит в `npm run typecheck` — иначе сборка
  // падала бы на чистом клоне. Проверять так:
  //   npm i -D playwright-core --no-save && npx tsc --noEmit -p tsconfig.store.json
  "extends": "./tsconfig.node.json",
  "include": ["store"]
}
