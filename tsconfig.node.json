{
  // Тесты и служебные скрипты гоняются в Node, а не в браузере: им нужны
  // типы node и НЕ нужен lib.dom, иначе легко случайно позвать браузерный
  // API из кода, который потом упадёт в тесте.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  // Только тесты. Файлы из src подтягиваются транзитивно по импортам — и это
  // полезная проверка: если в src/core или src/theme случайно появится
  // обращение к document или window, здесь оно упадёт, потому что lib.dom тут
  // не подключён. Ядро и тема обязаны быть независимы от браузера.
  //
  // Скрипты из store/ вынесены в tsconfig.store.json: им нужен playwright-core,
  // который ставится временно и в зависимостях проекта не числится.
  "include": ["test"]
}
